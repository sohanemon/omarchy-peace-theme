#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

usage() {
  cat <<'EOF'
Usage: peace-theme <action> [options]

Actions:
  init, uninstall, enable, disable, logs
  help
EOF
}

if (($# == 0)); then usage; exit 0; fi
ACTION="$1"; shift
if [[ $ACTION == help || $ACTION == -h || $ACTION == --help ]]; then
  if (($# == 0)); then usage; exit 0; fi
  ACTION="$1"; shift
  set -- --help "$@"
fi
COMMAND="$SCRIPT_DIR/peace-$ACTION"
if [[ ! -x $COMMAND ]]; then
  echo "peace-theme: unknown action '$ACTION'" >&2
  usage >&2
  exit 2
fi
exec "$COMMAND" "$@"
