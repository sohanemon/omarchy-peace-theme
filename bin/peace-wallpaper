#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: peace-wallpaper [random|next|prev]

Delegate ayah wallpaper rendering to the Omapeace command.
EOF
}

ACTION=random
if (($#)); then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --temp) exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/peace-initial-wallpaper" ;;
    random|next|prev) ACTION="$1"; shift ;;
    wallpaper)
      shift
      ACTION="${1:-random}"
      (($# == 0)) || shift
      ;;
    *) echo "peace-wallpaper: unknown action '$1'" >&2; usage >&2; exit 2 ;;
  esac
fi

if (($#)); then
  echo "peace-wallpaper: unexpected argument '$1'" >&2
  usage >&2
  exit 2
fi

exec "$HOME/.local/bin/peace" "$ACTION"
