#!/usr/bin/env bash
# Render a random ayah as a wallpaper sized to the display, using the active theme's colors.
set -euo pipefail

# NOTE: user wallpapers go in Omarchy's per-theme user dir, which the background
# switcher and theme rotation both read; the theme repo's backgrounds/ stays pristine
BG_DIR="$HOME/.config/omarchy/backgrounds/peace"
KEEP=3
MAX_LEN=200 # Skip ayahs whose Arabic text is longer than this
MAX_ATTEMPTS=10
API="https://api.alquran.cloud/v1/ayah"

RESOLUTION="2560x1440"
if MONITOR_RESOLUTION="$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused == true)][0] | if .width and .height then "\(.width)x\(.height)" else empty end' 2>/dev/null)" && [[ -n $MONITOR_RESOLUTION ]]; then
  RESOLUTION="$MONITOR_RESOLUTION"
fi

# NOTE: read all colors from the active theme's colors.toml via Omarchy state,
# not a hardcoded path; no custom keys are added to colors.toml
STATE_DIR="$HOME/.local/state/omarchy/current"
COLORS_TOML="$STATE_DIR/theme/colors.toml"

if [[ ! -f $COLORS_TOML ]]; then
  echo "peace-wallpaper: $COLORS_TOML not found, cannot read theme colors" >&2
  exit 1
fi

get_color() { # $1=key
  local key="$1"
  grep -E "^${key}[[:space:]]*=" "$COLORS_TOML" | head -1 | sed -E 's/^[^=]*= *"([^"]*)".*/\1/'
}

ACCENT="$(get_color accent)"
FOREGROUND="$(get_color foreground)"
BACKGROUND="$(get_color background)"
LIGHTER_BACKGROUND="$(get_color lighter_background)"
DARKER_BACKGROUND="$(get_color darker_background)"

if [[ -z $ACCENT || -z $FOREGROUND || -z $BACKGROUND || -z $LIGHTER_BACKGROUND || -z $DARKER_BACKGROUND ]]; then
  echo "peace-wallpaper: missing color key in $COLORS_TOML" >&2
  exit 1
fi

blend_color() { # $1=fg $2=bg $3=ratio(0-1)
  local fg="$1" bg="$2" ratio="$3"
  fg="${fg#\#}"; bg="${bg#\#}"
  local fr fg_g fg_b br bg_g bb r g b
  fr=$((16#${fg:0:2})); fg_g=$((16#${fg:2:2})); fg_b=$((16#${fg:4:2}))
  br=$((16#${bg:0:2})); bg_g=$((16#${bg:2:2})); bb=$((16#${bg:4:2}))
  r=$(awk -v bg=$br -v fg=$fr -v ratio=$ratio 'BEGIN { printf "%d", bg + (fg - bg) * ratio }')
  g=$(awk -v bg=$bg_g -v fg=$fg_g -v ratio=$ratio 'BEGIN { printf "%d", bg + (fg - bg) * ratio }')
  b=$(awk -v bg=$bb -v fg=$fg_b -v ratio=$ratio 'BEGIN { printf "%d", bg + (fg - bg) * ratio }')
  printf '#%02x%02x%02x' "$r" "$g" "$b"
}

contrast_ratio() { # $1=color1 $2=color2 -> prints WCAG ratio
  awk -v c1="$1" -v c2="$2" '
  function linearize(c) { c/=255; return c <= 0.03928 ? c/12.92 : ((c+0.055)/1.055)^2.4 }
  function hex2dec(h,    i,c,d,n) {
    n=0; for(i=1;i<=length(h);i++){c=substr(h,i,1); if(c~/[0-9]/)d=c+0; else if(c~/[aA]/)d=10; else if(c~/[bB]/)d=11; else if(c~/[cC]/)d=12; else if(c~/[dD]/)d=13; else if(c~/[eE]/)d=14; else if(c~/[fF]/)d=15; n=n*16+d}
    return n
  }
  function luminance(hex,    r,g,b) {
    r=hex2dec(substr(hex,1,2)); g=hex2dec(substr(hex,3,2)); b=hex2dec(substr(hex,5,2))
    return 0.2126*linearize(r) + 0.7152*linearize(g) + 0.0722*linearize(b)
  }
  BEGIN {
    l1=luminance(c1); l2=luminance(c2)
    if(l1<l2){t=l1;l1=l2;l2=t}
    printf "%.2f", (l1+0.05)/(l2+0.05)
  }
  '
}

# NOTE: colors.toml has no color8 key, so blend foreground into background for the
# muted reference text. Start at 25% foreground and raise it until contrast against
# lighter_background (the gradient's brightest center, where the text sits) is >= 4.5:1
BLEND=0.25
REF_COLOR="$(blend_color "$FOREGROUND" "$LIGHTER_BACKGROUND" "$BLEND")"
RATIO="$(contrast_ratio "$REF_COLOR" "$LIGHTER_BACKGROUND")"
while awk -v r="$RATIO" 'BEGIN { exit !(r < 4.5) }'; do
  BLEND=$(awk -v b="$BLEND" 'BEGIN { printf "%.2f", b + 0.05 }')
  REF_COLOR="$(blend_color "$FOREGROUND" "$LIGHTER_BACKGROUND" "$BLEND")"
  RATIO="$(contrast_ratio "$REF_COLOR" "$LIGHTER_BACKGROUND")"
  if awk -v b="$BLEND" 'BEGIN { exit !(b > 0.95) }'; then
    echo "peace-wallpaper: cannot reach 4.5:1 contrast, using best effort" >&2
    break
  fi
done
echo "peace-wallpaper: reference color $REF_COLOR contrast $RATIO:1 against $LIGHTER_BACKGROUND"

mkdir -p "$BG_DIR"

fetch_ayah() {
  local attempt json arabic english name number
  for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
    # NOTE: Quran has 6236 ayahs in the standard mushaf numbering
    json="$(curl -sf --max-time 15 "$API/$((RANDOM % 6236 + 1))/editions/quran-uthmani,en.sahih")" ||
      return 1
    arabic="$(jq -r '.data[0].text' <<<"$json")"
    english="$(jq -r '.data[1].text' <<<"$json")"
    name="$(jq -r '.data[0].surah.englishName' <<<"$json")"
    number="$(jq -r '.data[0].surah.number' <<<"$json")"
    local ayah="$(jq -r '.data[0].numberInSurah' <<<"$json")"
    if ((${#arabic} <= MAX_LEN)); then
      printf '%s\n%s\n%s %s:%s\n' "$arabic" "$english" "$name" "$number" "$ayah"
      return 0
    fi
  done
  return 1
}

RESULT="$(fetch_ayah)" || {
  echo "peace-wallpaper: fetch failed, keeping current wallpaper" >&2
  exit 1
}
readarray -t AYAH <<<"$RESULT"

ARABIC="${AYAH[0]}"
ENGLISH="${AYAH[1]}"
REFERENCE="${AYAH[2]}"

STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$BG_DIR/peace-$STAMP.png"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# NOTE: pango handles Arabic shaping/RTL correctly; plain convert does not
pango_render() { # $1=text $2=pango-markup
  magick -size "$3" -background none "pango:$2" "$TMP/$1.png"
}

render_ayah() {
  pango_render arabic "<span font_desc='Amiri 76' foreground='$ACCENT'>${ARABIC}</span>" 2100
  pango_render english "<span font_desc='DejaVu Serif 38' foreground='$FOREGROUND'>${ENGLISH}</span>" 1900
  pango_render reference "<span font_desc='DejaVu Sans 28' foreground='$REF_COLOR'>${REFERENCE}</span>" 1200
}

escape_pango() {
  ARABIC="${ARABIC//&/&amp;}"
  ARABIC="${ARABIC//</&lt;}"
  ARABIC="${ARABIC//>/&gt;}"
  ENGLISH="${ENGLISH//&/&amp;}"
  ENGLISH="${ENGLISH//</&lt;}"
  ENGLISH="${ENGLISH//>/&gt;}"
  REFERENCE="${REFERENCE//&/&amp;}"
  REFERENCE="${REFERENCE//</&lt;}"
  REFERENCE="${REFERENCE//>/&gt;}"
}

escape_pango
render_ayah

# Vertical stack of the three blocks, centered on the canvas
# NOTE: pango renders Arabic flush-right and English flush-left; trim so each block can be centered
magick "$TMP/arabic.png" -trim +repage "$TMP/arabic.png"
magick "$TMP/english.png" -trim +repage "$TMP/english.png"
magick "$TMP/reference.png" -trim +repage "$TMP/reference.png"

mapfile -t HEIGHTS < <(magick identify -format '%h\n' "$TMP/arabic.png" "$TMP/english.png" "$TMP/reference.png")
AR_H="${HEIGHTS[0]}"
EN_H="${HEIGHTS[1]}"
REF_H="${HEIGHTS[2]}"
GAP=70
STACK_H=$((AR_H + EN_H + REF_H + 2 * GAP))
EN_Y=$((AR_H + GAP))
REF_Y=$((EN_Y + EN_H + GAP))
magick -size "2100x${STACK_H}" xc:none \
  "$TMP/arabic.png" -gravity north -geometry +0+0 -compose over -composite \
  "$TMP/english.png" -gravity north -geometry +0+"$EN_Y" -compose over -composite \
  "$TMP/reference.png" -gravity north -geometry +0+"$REF_Y" -compose over -composite \
  "$TMP/stack.png"

# NOTE: colors follow the peace theme (green radial gradient, gold accent)
magick -size "$RESOLUTION" "radial-gradient:${LIGHTER_BACKGROUND}-${DARKER_BACKGROUND}" \
  "$TMP/stack.png" -gravity center -geometry +0-20 -compose over -composite \
  -quality 92 "$OUT"

# Keep only the newest $KEEP wallpapers
ls -t "$BG_DIR"/peace-*.png 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm --

omarchy theme bg set "$OUT"
echo "peace-wallpaper: set $OUT"
