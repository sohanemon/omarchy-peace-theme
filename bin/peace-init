#!/usr/bin/env bash
set -euo pipefail

if [[ ${1-} == -h || ${1-} == --help ]]; then
  cat <<'EOF'
Usage: peace-init

Check requirements, install Omapeace and theme commands, enable the wallpaper
timer, and set the initial random ayah wallpaper.
EOF
  exit 0
fi

if (($#)); then
  echo "peace-init: unexpected argument '$1'" >&2
  echo "Usage: peace-init" >&2
  exit 2
fi

THEME_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
UNIT_DIR="$HOME/.config/systemd/user"

if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "peace-init: systemctl --user is unavailable; start the user systemd manager first" >&2
  exit 1
fi

"$THEME_DIR/lib/peace-ensure-plugin"

mkdir -p "$UNIT_DIR" "$HOME/.local/bin"

for command_path in "$THEME_DIR"/bin/peace-*; do
  [[ -x $command_path ]] || continue
  ln -sf "$command_path" "$HOME/.local/bin/${command_path##*/}"
done
ln -sf "$THEME_DIR/systemd/peace-wallpaper.service" "$UNIT_DIR/peace-wallpaper.service"
ln -sf "$THEME_DIR/systemd/peace-wallpaper.timer" "$UNIT_DIR/peace-wallpaper.timer"

systemctl --user daemon-reload
systemctl --user enable --now peace-wallpaper.timer
"$THEME_DIR/lib/peace-initial-wallpaper"

echo "peace initialized. Check the timer with: systemctl --user list-timers"
