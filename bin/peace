#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

usage() {
  cat <<'EOF'
Usage: peace <action> [options]

Actions (also available as `peace-<action>` commands):
  init, uninstall, enable, disable, status, logs
  random, next, prev, wallpaper

Use 'peace <action> --help' or 'peace-<action> --help' for details.
EOF
}

if (($# == 0)); then
  usage
  exit 0
fi

ACTION="$1"
shift
if [[ $ACTION == help || $ACTION == -h || $ACTION == --help ]]; then
  if (($# == 0)); then
    usage
    exit 0
  fi
  ACTION="$1"
  shift
  set -- --help "$@"
fi

COMMAND="$SCRIPT_DIR/peace-$ACTION"
if [[ ! -x $COMMAND ]]; then
  echo "peace: unknown action '$ACTION'" >&2
  usage >&2
  exit 2
fi
exec "$COMMAND" "$@"
