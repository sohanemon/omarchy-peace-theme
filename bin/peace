#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

usage() {
  cat <<'EOF'
Usage: peace <action> [options]

Actions:
  listen SURAH[:AYAH|:START-END|:START-] [--reciter ID] [--follow] [--buffer N]
  pause, stop, status
  wallpaper [args...]  Forward arguments to peace-wallpaper
  init, uninstall, enable, disable, logs, random, next, prev
  help

Run 'peace listen --help' for listening details.
EOF
}

if (($# == 0)); then usage; exit 0; fi
ACTION="$1"; shift
if [[ $ACTION == help || $ACTION == -h || $ACTION == --help ]]; then
  if (($# == 0)); then usage; exit 0; fi
  ACTION="$1"; shift
  set -- --help "$@"
fi
if [[ $ACTION == wallpaper ]]; then exec "$SCRIPT_DIR/peace-wallpaper" "$@"; fi
if [[ $ACTION == __follow ]]; then exec "$SCRIPT_DIR/peace-listen" __follow "$@"; fi
if [[ $ACTION == listen || $ACTION == pause || $ACTION == stop || $ACTION == status ]]; then
  COMMAND="$SCRIPT_DIR/peace-$ACTION"
  if [[ -x $COMMAND ]]; then exec "$COMMAND" "$@"; fi
  exec "$SCRIPT_DIR/peace-listen" "$@"
fi
COMMAND="$SCRIPT_DIR/peace-$ACTION"
if [[ ! -x $COMMAND ]]; then
  echo "peace: unknown action '$ACTION'" >&2
  usage >&2
  exit 2
fi
exec "$COMMAND" "$@"
