#!/usr/bin/env bash
# Install the peace-wallpaper systemd user units.
set -euo pipefail

THEME_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
UNIT_DIR="$HOME/.config/systemd/user"

if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "peace-wallpaper-install: systemctl --user is unavailable; start the user systemd manager first" >&2
  exit 1
fi

"$THEME_DIR/lib/peace-ensure-plugin"

mkdir -p "$UNIT_DIR" "$HOME/.local/bin"

for command_path in "$THEME_DIR"/bin/peace-*; do
  [[ -x $command_path ]] || continue
  ln -sf "$command_path" "$HOME/.local/bin/${command_path##*/}"
done
ln -sf "$THEME_DIR/bin/peace-theme" "$HOME/.local/bin/peace-theme"
ln -sf "$THEME_DIR/systemd/peace-wallpaper.service" "$UNIT_DIR/peace-wallpaper.service"
ln -sf "$THEME_DIR/systemd/peace-wallpaper.timer" "$UNIT_DIR/peace-wallpaper.timer"

systemctl --user daemon-reload
systemctl --user enable --now peace-wallpaper.timer
"$HOME/.local/bin/peace-wallpaper" --temp random

echo "peace-wallpaper timer installed. Check with: systemctl --user list-timers"
