#!/usr/bin/env bash
set -euo pipefail

THEME_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
STATE="$HOME/.local/state/peace"
CACHE="$HOME/.cache/peace"
FOLLOW_CACHE="$CACHE/follow"
PLAY_FILE="$STATE/play.json"
PID_FILE="$STATE/mpv.pid"
SUPERVISOR_FILE="$STATE/follow.pid"
FOLLOWING_FILE="$STATE/following"
SOCK="${XDG_RUNTIME_DIR:-/tmp}/peace-mpv${XDG_RUNTIME_DIR:+}.sock"
if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then SOCK="/tmp/peace-mpv-${UID}.sock"; else SOCK="$XDG_RUNTIME_DIR/peace-mpv.sock"; fi
SURAH_CACHE="$CACHE/surahs.json"

usage() {
  cat <<'HELP'
Usage: peace listen SURAH[:AYAH|:START-END|:START-] [--reciter ID] [--follow] [--buffer N]
Examples: peace listen 55 | 55:5 | 55:5-10 | 55:5- --follow --buffer 6
HELP
}

mpv_alive() {
  local pid
  [[ -r $PID_FILE ]] || return 1
  pid="$(<"$PID_FILE")"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ -r /proc/$pid/cmdline ]] && tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq -- "--input-ipc-server=$SOCK"
}
send_ipc() { printf '%s\n' "$1" | socat - "UNIX-CONNECT:$SOCK" 2>/dev/null; }

stop_all() {
  local mpv_pid="" supervisor_pid="" worker_pid=""
  [[ -r $PID_FILE ]] && mpv_pid="$(<"$PID_FILE")"
  [[ -r $SUPERVISOR_FILE ]] && supervisor_pid="$(<"$SUPERVISOR_FILE")"
  [[ -r $STATE/follow-worker.pid ]] && worker_pid="$(<"$STATE/follow-worker.pid")"
  mpv_alive && kill "$mpv_pid" 2>/dev/null || true
  [[ $supervisor_pid =~ ^[0-9]+$ ]] && kill "$supervisor_pid" 2>/dev/null || true
  [[ $worker_pid =~ ^[0-9]+$ ]] && kill -- -"$worker_pid" 2>/dev/null || true
  for _ in {1..20}; do
    alive=false
    mpv_alive && alive=true
    [[ $supervisor_pid =~ ^[0-9]+$ ]] && kill -0 "$supervisor_pid" 2>/dev/null && alive=true
    [[ $worker_pid =~ ^[0-9]+$ ]] && kill -0 "$worker_pid" 2>/dev/null && alive=true
    [[ $alive == false ]] && break
    sleep 0.1
  done
  rm -f -- "$SOCK" "$PID_FILE" "$PLAY_FILE" "$SUPERVISOR_FILE" "$FOLLOWING_FILE" "$STATE/follow-worker.pid" "$STATE/displayed-ayah"
  rm -rf -- "$FOLLOW_CACHE"
}

query_position() {
  send_ipc '{"command":["get_property","playlist-pos"]}' | jq -r '.data // empty' | head -n1
}

if [[ ${1-} == __worker ]]; then
  BUFFER="$2"
  while mpv_alive; do
    pos="$(query_position || true)"
    if [[ $pos =~ ^[0-9]+$ ]]; then
      current=$(( $(jq -r '.start' "$PLAY_FILE") + pos ))
      surah="$(jq -r .surah "$PLAY_FILE")"; end="$(jq -r .end "$PLAY_FILE")"
      for old in "$FOLLOW_CACHE"/"$surah"-*.png "$FOLLOW_CACHE"/"$surah"-*.skip; do
        [[ -e $old ]] || continue
        old_ayah="${old##*/}"; old_ayah="${old_ayah#*-}"; old_ayah="${old_ayah%%.*}"
        if ((old_ayah < current)) && [[ "$surah-$old_ayah" != "$(cat "$STATE/displayed-ayah" 2>/dev/null || true)" ]]; then rm -f -- "$old"; fi
      done
      for ((next=current; next<=end && next<current+BUFFER+1; next++)); do
        ref="$surah-$next"; out="$FOLLOW_CACHE/$ref.png"
        [[ -s $out || -e "$FOLLOW_CACHE/$ref.skip" ]] && continue
        for attempt in 1 2; do
          if nice -n 15 "$THEME_DIR/bin/peace-wallpaper" --ref "$surah:$next" --out "$out"; then
            printf '[%s] render finished %s:%s (attempt %s)\n' "$(date --iso-8601=seconds)" "$surah" "$next" "$attempt" >> "$STATE/follow.log"
            break
          fi
          printf '[%s] render failed %s:%s (attempt %s)\n' "$(date --iso-8601=seconds)" "$surah" "$next" "$attempt" >> "$STATE/follow.log"
        done
        [[ -s $out ]] || : > "$FOLLOW_CACHE/$ref.skip"
        find "$FOLLOW_CACHE" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' | sort -nr | tail -n +$((BUFFER+3)) | cut -d' ' -f2- | xargs -r rm -f --
      done
    fi
    sleep 1
  done
  exit 0
fi

COMMAND_NAME="${0##*/}"
if [[ ${1-} == --help || ${1-} == -h ]]; then
  case "$COMMAND_NAME" in
    peace-pause) echo 'Usage: peace pause'; echo 'Toggle audio pause or resume.' ;;
    peace-stop) echo 'Usage: peace stop'; echo 'Stop audio and follow rendering.' ;;
    peace-status) echo 'Usage: peace status'; echo 'Show the current ayah and playback state.' ;;
    *) usage ;;
  esac
  exit 0
fi
if [[ $COMMAND_NAME == peace-pause || $COMMAND_NAME == peace-stop || $COMMAND_NAME == peace-status ]]; then
  if (($#)); then echo "$COMMAND_NAME: unexpected argument '$1'" >&2; exit 2; fi
fi

if [[ ${0##*/} == peace-pause ]]; then
  if ! mpv_alive || ! command -v socat >/dev/null 2>&1; then echo 'not playing' >&2; exit 1; fi
  send_ipc '{"command":["cycle","pause"]}' >/dev/null || { echo 'not playing' >&2; exit 1; }
  exit 0
fi
if [[ ${0##*/} == peace-stop ]]; then stop_all; exit 0; fi
if [[ ${0##*/} == peace-status ]]; then
  if ! mpv_alive; then echo 'not playing'; exit 0; fi
  if ! command -v socat >/dev/null 2>&1 || [[ ! -r $PLAY_FILE ]]; then echo 'playing'; exit 0; fi
  pos="$(query_position || true)"
  [[ $pos =~ ^[0-9]+$ ]] || { echo 'playing'; exit 0; }
  read -r start end surah reciter follow < <(jq -r '[.start,.end,.surah,.reciter,(if .follow then "yes" else "no" end)]|@tsv' "$PLAY_FILE")
  ayah=$((start + pos))
  ((ayah > end)) && ayah=$end
  line="playing $surah:$ayah (reciter $reciter"
  if [[ $follow == yes && -r $SUPERVISOR_FILE ]] && kill -0 "$(<"$SUPERVISOR_FILE")" 2>/dev/null; then line+=", following"; fi
  echo "$line)"
  exit 0
fi

if [[ ${1-} == __follow ]]; then
  shift
  BUFFER="$1"
  mkdir -p "$STATE" "$FOLLOW_CACHE"
  SUP_PID="$$"
  echo "$SUP_PID" > "$FOLLOWING_FILE"
  echo "$SUP_PID" > "$SUPERVISOR_FILE"
  LOG="$STATE/follow.log"
  log_event() { printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*" >> "$LOG"; }
  setsid "$THEME_DIR/bin/peace-listen" __worker "$BUFFER" </dev/null >>"$LOG" 2>&1 &
  WORKER_PID=$!
  echo "$WORKER_PID" > "$STATE/follow-worker.pid"
  trap 'kill -- -"$WORKER_PID" 2>/dev/null || true; rm -f "$FOLLOWING_FILE" "$SUPERVISOR_FILE" "$STATE/follow-worker.pid" "$PID_FILE" "$PLAY_FILE"; rm -rf "$FOLLOW_CACHE"' EXIT
  trap 'exit 0' TERM INT
  last_ref=""
  while mpv_alive; do
    pos="$(query_position || true)"
    if [[ $pos =~ ^[0-9]+$ ]]; then
      surah="$(jq -r .surah "$PLAY_FILE")"; ayah=$(( $(jq -r .start "$PLAY_FILE") + pos )); ref="$surah-$ayah"
      if [[ $ref != "$last_ref" ]]; then last_ref="$ref"; fi
      candidate="$FOLLOW_CACHE/$ref.png"
      if [[ -s $candidate && "$(cat "$STATE/displayed-ayah" 2>/dev/null || true)" != "$ref" ]]; then
        fresh_pos="$(query_position || true)"
        [[ $fresh_pos =~ ^[0-9]+$ ]] || { sleep 0.5; continue; }
        fresh_ayah=$(( $(jq -r .start "$PLAY_FILE") + fresh_pos ))
        [[ $fresh_ayah == "$ayah" ]] || { sleep 0.5; continue; }
        stamp="$(date +%s%3N)"; bgdir="$HOME/.config/omarchy/backgrounds/peace"
        mkdir -p "$bgdir"; target="$bgdir/follow-$stamp.png"
        cp -- "$candidate" "$target"
        omarchy theme bg set "$target" >/dev/null 2>&1 || true
        echo "$ref" > "$STATE/displayed-ayah"
        log_event "wallpaper switched $surah:$ayah"
        find "$bgdir" -maxdepth 1 -type f -name 'follow-*.png' -printf '%T@ %p\0' | sort -z -nr | tail -z -n +3 | while IFS= read -r -d '' entry; do rm -f -- "${entry#* }"; done
      fi
    fi
    sleep 0.5
  done
  exit 0
fi
if (($# == 0)); then usage >&2; exit 2; fi
REF="$1"; shift
RECITER="${PEACE_RECITER:-ar.alafasy}"; FOLLOW=false; BUFFER=10
while (($#)); do
  case "$1" in
    --reciter) (($# >= 2)) || { echo 'peace listen: --reciter requires an ID' >&2; exit 2; }; RECITER="$2"; shift 2 ;;
    --follow) FOLLOW=true; shift ;;
    --buffer) (($# >= 2)) || { echo 'peace listen: --buffer requires N' >&2; exit 2; }; BUFFER="$2"; shift 2 ;;
    *) echo "peace listen: unknown option '$1'" >&2; exit 2 ;;
  esac
done
if ! [[ $BUFFER =~ ^[0-9]+$ ]] || ((BUFFER < 1 || BUFFER > 20)); then echo 'peace listen: --buffer must be between 1 and 20' >&2; exit 2; fi
if ! [[ $RECITER =~ ^[A-Za-z0-9._-]+$ ]]; then echo 'peace listen: invalid reciter ID' >&2; exit 2; fi
if ! [[ $REF =~ ^([0-9]+)(:([0-9]+)(-([0-9]*)?)?)?$ ]]; then echo "peace listen: invalid reference '$REF' (expected SURAH[:AYAH|:START-END|:START-])" >&2; exit 2; fi
SURAH="${BASH_REMATCH[1]}"; START="${BASH_REMATCH[3]:-1}"; END="${BASH_REMATCH[5]:-}"
if ((SURAH < 1 || SURAH > 114)); then echo 'peace listen: surah must be between 1 and 114' >&2; exit 2; fi
stop_all
if [[ -z $END ]]; then END="$START"; [[ $REF == "$SURAH" || $REF == *- ]] && END=0; fi
mkdir -p "$CACHE" "$STATE"
if [[ ! -s $SURAH_CACHE || $(($(date +%s) - $(stat -c %Y "$SURAH_CACHE"))) -gt 2592000 ]]; then
  table="$(curl -fsSL --connect-timeout 8 --max-time 20 https://api.alquran.cloud/v1/surah 2>/dev/null | jq -ce '[.data[] | {number, numberOfAyahs}]' 2>/dev/null)" || { echo 'peace listen: unable to fetch surah list from AlQuran Cloud' >&2; exit 1; }
  printf '%s\n' "$table" > "$SURAH_CACHE.tmp" && mv "$SURAH_CACHE.tmp" "$SURAH_CACHE"
fi
COUNT="$(jq -r --argjson s "$SURAH" '.[] | select(.number==$s) | .numberOfAyahs' "$SURAH_CACHE")"
if [[ -z $COUNT || ! $START =~ ^[0-9]+$ ]] || ((START < 1)); then echo 'peace listen: invalid ayah number' >&2; exit 2; fi
if ((END == 0)); then END=$COUNT; fi
if ((START > COUNT || END > COUNT)); then echo "peace listen: surah $SURAH has $COUNT ayahs" >&2; exit 2; fi
if ((START > END)); then echo 'peace listen: ayah range start must be less than or equal to end' >&2; exit 2; fi
SURAH_JSON="$(curl -fsSL --connect-timeout 8 --max-time 25 "https://api.alquran.cloud/v1/surah/$SURAH/$RECITER" 2>/dev/null)" || { echo "peace listen: unable to fetch audio for surah $SURAH ($RECITER)" >&2; exit 1; }
URLS="$(jq -er --argjson start "$START" --argjson end "$END" '[.data.ayahs[] | select(.numberInSurah >= $start and .numberInSurah <= $end) | .audio] | if length == ($end-$start+1) and all(.[]; type=="string" and length>0) then .[] else error("missing audio URLs") end' <<<"$SURAH_JSON" 2>/dev/null)" || { echo "peace listen: audio URLs missing for surah $SURAH ($RECITER)" >&2; exit 1; }
command -v mpv >/dev/null 2>&1 || { echo 'peace listen: mpv is required (install with: omarchy pkg add mpv)' >&2; exit 1; }
mkdir -p "$STATE"
PLAYLIST=(); while IFS= read -r url; do PLAYLIST+=("$url"); done <<<"$URLS"
printf '{"surah":%s,"start":%s,"end":%s,"reciter":"%s","follow":%s}\n' "$SURAH" "$START" "$END" "$RECITER" "$FOLLOW" > "$PLAY_FILE"
setsid mpv --no-video --no-terminal --really-quiet --gapless-audio=yes --prefetch-playlist=yes --input-ipc-server="$SOCK" "${PLAYLIST[@]}" </dev/null >/dev/null 2>&1 &
echo "$!" > "$PID_FILE"
if [[ $FOLLOW == true ]]; then
  active_theme="$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)"
  if [[ $active_theme != peace ]]; then echo "peace listen: warning: active theme is '$active_theme'; playing audio without wallpaper follow" >&2
  elif ! command -v socat >/dev/null 2>&1; then echo 'peace listen: warning: socat is missing; --follow unavailable' >&2
  else
    setsid "$THEME_DIR/bin/peace" __follow "$BUFFER" </dev/null >/dev/null 2>&1 &
  fi
fi
exit 0
