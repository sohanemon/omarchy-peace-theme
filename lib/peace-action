#!/usr/bin/env bash
set -euo pipefail

COMMAND="${0##*/}"
ACTION="${COMMAND#peace-}"
usage() {
  case "$ACTION" in
    enable) echo "Usage: $COMMAND"; echo "Enable and start the Peace wallpaper timer." ;;
    disable) echo "Usage: $COMMAND"; echo "Stop and disable the Peace wallpaper timer." ;;
    logs) echo "Usage: $COMMAND"; echo "Show the 50 most recent Peace wallpaper service log entries." ;;
    *) echo "$COMMAND: unknown action" >&2; return 2 ;;
  esac
}

if [[ ${1-} == -h || ${1-} == --help ]]; then
  usage
  exit $?
fi

case "$ACTION" in
  enable)
    if (($#)); then echo "$COMMAND: takes no arguments" >&2; exit 2; fi
    systemctl --user enable --now peace-wallpaper.timer
    ;;
  disable)
    if (($#)); then echo "$COMMAND: takes no arguments" >&2; exit 2; fi
    systemctl --user disable --now peace-wallpaper.timer
    systemctl --user stop peace-wallpaper.service || true
    ;;
  logs)
    if (($#)); then echo "$COMMAND: takes no arguments" >&2; exit 2; fi
    journalctl --user -u peace-wallpaper.service -n 50 --no-pager
    ;;
  *)
    echo "$COMMAND: unknown action '$ACTION'" >&2
    exit 2
    ;;
esac
